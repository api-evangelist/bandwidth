{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bandwidth Emergency Calling Available Numbers Disconnects API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Disconnects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Disconnect phone numbers",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://dashboard.bandwidth.com/api/accounts/:accountId/disconnects",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the Bandwidth account"
              }
            ]
          },
          "docs": "Creates a request to disconnect and release phone numbers from the account. Disconnected numbers are returned to Bandwidth's available inventory."
        }
      ]
    }
  ],
  "bundled": true
}