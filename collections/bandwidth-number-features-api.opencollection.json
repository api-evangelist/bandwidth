{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bandwidth Emergency Calling Available Numbers Number Features API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Number Features",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update phone number features",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://dashboard.bandwidth.com/api/accounts/:accountId/tns/:phoneNumber/tnfeatureorder",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the Bandwidth account"
              },
              {
                "name": "phoneNumber",
                "value": "",
                "type": "path",
                "description": "The phone number to update features for"
              }
            ]
          },
          "docs": "Creates a feature order to configure features such as CNAM, directory listings, and line features for a specific phone number."
        }
      ]
    }
  ],
  "bundled": true
}