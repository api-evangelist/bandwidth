{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bandwidth Emergency Calling Available Numbers Phone Numbers API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Phone Numbers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List phone numbers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dashboard.bandwidth.com/api/accounts/:accountId/tns",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the Bandwidth account"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              },
              {
                "name": "city",
                "value": "",
                "type": "query",
                "description": "Filter by city"
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "Filter by state abbreviation"
              },
              {
                "name": "lata",
                "value": "",
                "type": "query",
                "description": "Filter by LATA code"
              }
            ]
          },
          "docs": "Retrieves a list of phone numbers assigned to the account. Supports filtering by various criteria including city, state, and LATA."
        },
        {
          "info": {
            "name": "Get phone number details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dashboard.bandwidth.com/api/accounts/:accountId/tns/:phoneNumber",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the Bandwidth account"
              },
              {
                "name": "phoneNumber",
                "value": "",
                "type": "path",
                "description": "The phone number to look up (digits only)"
              }
            ]
          },
          "docs": "Retrieves detailed information about a specific phone number including its assignment, features, and configuration."
        }
      ]
    }
  ],
  "bundled": true
}