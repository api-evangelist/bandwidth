    {
      "id": "71ab6a49-fa76-4ecb-bdbb-827546273bb4",
      "name": "Available Numbers",
      "description": {
        "content": "Search for available phone numbers by area code, NPA-NXX, rate center, city, state, or ZIP code. Returns numbers available for ordering.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e7dfe653-a07b-4edc-a154-b8d5cef7caf0",
          "name": "Search available phone numbers",
          "request": {
            "name": "Search available phone numbers",
            "description": {
              "content": "Searches Bandwidth's inventory for available phone numbers matching the specified criteria. Supports searches by area code, NPA-NXX, rate center, city, state, ZIP code, and LATA. Returns up to the requested quantity of available numbers.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":accountId",
                "availableNumbers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "areaCode",
                  "value": "<string>",
                  "description": "Three-digit area code to search"
                },
                {
                  "disabled": false,
                  "key": "npaNxx",
                  "value": "<string>",
                  "description": "Six-digit NPA-NXX combination to search"
                },
                {
                  "disabled": false,
                  "key": "rateCenter",
                  "value": "<string>",
                  "description": "Rate center name to search"
                },
                {
                  "disabled": false,
                  "key": "city",
                  "value": "<string>",
                  "description": "City name to search"
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "Two-letter state abbreviation"
                },
                {
                  "disabled": false,
                  "key": "zip",
                  "value": "<string>",
                  "description": "Five-digit ZIP code to search"
                },
                {
                  "disabled": false,
                  "key": "lata",
                  "value": "<string>",
                  "description": "LATA code to search"
                },
                {
                  "disabled": false,
                  "key": "quantity",
                  "value": "5000",
                  "description": "Number of results to return (1-5000, default 5000)"
                },
                {
                  "disabled": false,
                  "key": "tollFreeWildCardPattern",
                  "value": "<string>",
                  "description": "Toll-free number pattern using wildcards (e.g., 8**) for toll-free number searches"
                },
                {
                  "disabled": false,
                  "key": "enableTNDetail",
                  "value": "false",
                  "description": "Include detailed information for each number"
                },
                {
                  "disabled": false,
                  "key": "localVanity",
                  "value": "<string>",
                  "description": "Vanity number search pattern"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "accountId",
                  "description": "(Required) The unique identifier for the Bandwidth account"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
