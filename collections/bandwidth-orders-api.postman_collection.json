          "name": "Create a phone number order",
          "request": {
            "name": "Create a phone number order",
            "description": {
              "content": "Creates a new order to purchase phone numbers from Bandwidth's available inventory. The order specifies which numbers to purchase and the site and SIP peer to assign them to. Order status can be tracked via the GET endpoint or webhook callbacks.",
              "type": "text/plain"
            },
