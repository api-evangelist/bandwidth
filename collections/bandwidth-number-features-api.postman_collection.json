          "name": "Update phone number features",
          "request": {
            "name": "Update phone number features",
            "description": {
              "content": "Creates a feature order to configure features such as CNAM, directory listings, and line features for a specific phone number.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":accountId",
                "tns",
                ":phoneNumber",
                "tnfeatureorder"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "accountId",
                  "description": "(Required) The unique identifier for the Bandwidth account"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "phoneNumber",
                  "description": "(Required) The phone number to update features for"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/xml"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <callingNameDisplay>\n    <enabled>(boolean)</enabled>\n    <callingName>(string)</callingName>\n  </callingNameDisplay>\n  <directoryListing>\n    <listed>(boolean)</listed>\n    <listingType>(string)</listingType>\n    <listingName>(string)</listingName>\n    <listAddress>(boolean)</listAddress>\n  </directoryListing>\n</element>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
