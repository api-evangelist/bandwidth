          "name": "Send a message",
          "request": {
            "name": "Send a message",
            "description": {
              "content": "Sends an SMS or MMS message from a Bandwidth number. For MMS, include media URLs in the request body. Bandwidth will return an HTTP 202 Accepted indicating the message has been queued for delivery. Delivery status will be provided via webhook callbacks.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                ":accountId",
                "messages"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "accountId",
                  "description": "(Required) The unique identifier for the Bandwidth account"
                }
              ]
            },
