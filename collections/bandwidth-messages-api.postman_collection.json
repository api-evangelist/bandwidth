        {
          "id": "82cdfcce-0b11-4602-9799-b9d6f4da4ec3",
          "name": "List messages",
          "request": {
            "name": "List messages",
            "description": {
              "content": "Retrieves a list of message metadata for the account. Bandwidth does not store message content for privacy reasons; only metadata such as sender, recipient, timestamps, and delivery status is returned. Supports filtering by source number, destination number, and date range.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                ":accountId",
                "messages"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "messageId",
                  "value": "<string>",
                  "description": "Filter by a specific message ID"
                },
                {
                  "disabled": false,
                  "key": "sourceTn",
                  "value": "<string>",
                  "description": "Filter by source telephone number in E.164 format"
                },
                {
                  "disabled": false,
                  "key": "destinationTn",
                  "value": "<string>",
                  "description": "Filter by destination telephone number in E.164 format"
                },
                {
                  "disabled": false,
                  "key": "messageStatus",
                  "value": "<string>",
                  "description": "Filter by message delivery status"
                },
                {
                  "disabled": false,
                  "key": "messageDirection",
                  "value": "<string>",
                  "description": "Filter by message direction"
                },
                {
                  "disabled": false,
                  "key": "carrierName",
                  "value": "<string>",
                  "description": "Filter by carrier name"
                },
                {
                  "disabled": false,
                  "key": "messageType",
                  "value": "<string>",
                  "description": "Filter by message type"
                },
                {
                  "disabled": false,
                  "key": "errorCode",
                  "value": "<integer>",
                  "description": "Filter by error code"
                },
                {
                  "disabled": false,
                  "key": "fromDateTime",
                  "value": "<dateTime>",
                  "description": "Filter messages sent on or after this date-time"
                },
                {
                  "disabled": false,
                  "key": "toDateTime",
                  "value": "<dateTime>",
                  "description": "Filter messages sent on or before this date-time"
                },
                {
                  "disabled": false,
                  "key": "pageToken",
                  "value": "<string>",
                  "description": "Page token for pagination"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "Maximum number of messages to return"
                }
              ],
              "variable": [
                {
                  "disabled": false,
